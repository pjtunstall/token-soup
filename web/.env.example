# Empty = same origin; in dev, Vite proxies /api to the Go API.
PUBLIC_API_URL=

# Supabase (browser). Create a user in the dashboard or enable email sign-in.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

PUBLIC_ROLE_NAME_MAX_CHARS=64
PUBLIC_USER_MESSAGE_MAX_CHARS=12000

DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
