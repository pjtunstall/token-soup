# Required for LLM replies (local and supabase modes).
OPENROUTER_API_KEY=<api-key>

# --- supabase mode only (-mode supabase / make run-supabase) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Session pooler connection string from the Supabase dashboard.
# Apply repo schema (rebuilds `public`): from repo root, `npm run db:apply-schema` (needs `psql`).
# In local mode (make run), Compose sets DATABASE_URL to the throwaway Postgres service instead.
DATABASE_URL=postgres://postgres.rgtitrcftdgujvaxnkam:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Shared with web/.env.example
PUBLIC_ROLE_NAME_MAX_CHARS=64
PUBLIC_ROLE_DESCRIPTION_MAX_CHARS=2000
PUBLIC_USER_MESSAGE_MAX_CHARS=12000
