OPENROUTER_API_KEY=<api-key>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Database -> Connect (project) -> direct connection string; append ?sslmode=require if needed.
# Apply repo schema (rebuilds `public`): from repo root, `npm run db:apply-schema` (needs `psql`).
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:<port>/postgres/?sslmode=require

# Shared with web/.env.example
PUBLIC_ROLE_NAME_MAX_CHARS=64
PUBLIC_ROLE_DESCRIPTION_MAX_CHARS=2000
PUBLIC_USER_MESSAGE_MAX_CHARS=12000
